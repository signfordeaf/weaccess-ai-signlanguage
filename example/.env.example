# Build-time configuration for the example app.
#
# Copy this file to `.env` (which is gitignored) and fill in the values, or
# export the same names in the shell that starts Metro — a shell value wins
# over the file. Babel inlines them into the bundle at transform time, so the
# credentials never live in source control.
#
# After editing `.env`, restart Metro with `yarn start --reset-cache`.

# Required — the key SignForDeaf issued you (sent as the `rk` parameter).
SFD_API_KEY=
# Required — backend base URL.
SFD_API_URL=

# Optional URL parameters. Leave empty to use the SDK's own defaults.
# Identifies your app: sent as the `Origin` header and the `url` parameter.
SFD_ORIGIN_URL=
# Form/Domain id (`fdid`).
SFD_FDID=
# Translation id (`tid`).
SFD_TID=
